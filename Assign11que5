def main():
    num= int(input("Enter a number : "))
    temp = num
    reverse = 0

    while num > 0 :
        digit = num % 10
        reverse = reverse * 10 + digit
        num = num // 10

        if temp == reverse :
            print(num, " is a palindrome number")
        else : 
            print(num, " num is not a palindrome number")    
        

if __name__ == "__main__":
    main()